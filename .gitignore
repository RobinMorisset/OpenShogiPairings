# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Tauri build output
frontend/src-tauri/target/
frontend/src-tauri/gen/

# Per-checkout dev server state, written by scripts/dev-worktree.mjs: the
# tournaments and backups of a scratch worktree, kept inside it rather than in
# the per-user directory the real app uses, so a second server cannot list (or
# overwrite) the first one's data.
.dev-data/

# Claude Code runtime artifacts. launch.json is machine-specific (absolute
# paths to node/cargo vary per dev machine and the preview tool's spawn
# environment doesn't inherit shell PATH customizations), so each developer
# keeps their own local copy rather than sharing one through git.
.claude/launch.json
.claude/scheduled_tasks.lock

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Result files generated from FESA HTML results pages by
# scripts/fesa_html_to_results.py — one subdirectory per season (spring2017 …
# spring2026). Regenerate on demand rather than tracking the (large, partly
# importer-unsupported) batch.
test_files/fesa_results/

# mm_study.py large output (raw per-run dumps, staged configs, manifests)
/study_*/
