    "svelte-check": "^4.1.4",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.11",
    "vitest": "^4.1.10"
