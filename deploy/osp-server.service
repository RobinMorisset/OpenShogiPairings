# systemd unit for the OpenShogiPairings server (bare-metal / VPS option).
#
# Install:
#   sudo cp deploy/osp-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now osp-server
#
# The shared password lives in an EnvironmentFile (chmod 600), NOT inline here,
# so it isn't world-readable in the unit. Create /etc/osp/osp.env with:
#   OSP_PASSWORD=your-long-shared-referee-password
#
# Assumes the binary at /opt/osp/osp-server, the built SPA at /opt/osp/dist, and
# a writable /var/lib/osp for the persisted tournament (own them by the `osp`
# user). Put Caddy (see Caddyfile) in front for TLS.

[Unit]
Description=OpenShogiPairings tournament server
After=network.target

[Service]
Type=simple
User=osp
Group=osp
EnvironmentFile=/etc/osp/osp.env
Environment=OSP_BIND=127.0.0.1:3000
Environment=OSP_STATIC_DIR=/opt/osp/dist
Environment=OSP_DATA_FILE=/var/lib/osp/tournament.json
ExecStart=/opt/osp/osp-server
Restart=on-failure
RestartSec=2

# Light hardening — the server only needs to read its dir and write the data file.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/osp

[Install]
WantedBy=multi-user.target
