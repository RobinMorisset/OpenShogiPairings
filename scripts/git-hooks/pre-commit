#!/bin/sh
# Fast local gate: formatting + lint (Rust), type-check + lint (frontend).
# Full test suite runs in pre-push instead, to keep commits snappy.
set -e

echo "== rustfmt (staged .rs) =="
# Auto-format the staged .rs files instead of just gating on them. A commit
# captures the INDEX, not the working tree, so we re-stage what rustfmt rewrites
# — but only for files that are FULLY staged. Re-staging a file that also has
# unstaged changes would silently fold that unstaged work into the commit, so a
# partially-staged file that rustfmt would rewrite is reported and gates instead.
staged_rs=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
if [ -n "$staged_rs" ]; then
  # Files with unstaged changes (partial staging), space-wrapped for a `case`
  # membership test that stays clean under `set -e`.
  unstaged_rs=" $(git diff --name-only -- '*.rs' | tr '\n' ' ') "

  bad_partial=""
  # shellcheck disable=SC2086
  for f in $staged_rs; do
    before=$(git hash-object -- "$f")
    rustfmt --edition 2021 "$f"
    after=$(git hash-object -- "$f")
    [ "$before" = "$after" ] && continue   # already formatted, nothing to do

    case "$unstaged_rs" in
      *" $f "*)
        # Partially staged: can't fold the reformat in without also grabbing the
        # unstaged hunks. Flag it and gate below.
        bad_partial="$bad_partial $f" ;;
      *)
        # Fully staged: re-stage the formatted version — just normalizes what's
        # already going into the commit.
        git add -- "$f"
        echo "   formatted and re-staged: $f" ;;
    esac
  done

  if [ -n "$bad_partial" ]; then
    echo
    echo "pre-commit: partially staged .rs file(s) still need formatting:"
    # shellcheck disable=SC2086
    for f in $bad_partial; do echo "    $f"; done
    echo "  Stage them fully (git add <file>), or format + stage by hand, then re-commit."
    exit 1
  fi
fi

echo "== cargo clippy =="
cargo clippy --workspace --all-targets -- -D warnings

echo "== Cargo.lock freshness =="
# Both lockfiles have a habit of landing a few commits late, for two reasons:
#   - frontend/src-tauri is excluded from the workspace (see the top-level
#     Cargo.toml), so nothing in the usual loop resolves it. A dependency added
#     to a path crate like osp-core leaves its lock stale until someone happens
#     to build the desktop app, long after the commit that caused it.
#   - the root lock is the opposite problem: the clippy above refreshes it as a
#     side effect, so it sits modified-but-unstaged and misses the commit.
# Re-resolve each (a no-op when fresh) and stage whatever moved, so the lock
# travels with the manifest change instead of trailing it.
#   `update -w` only re-locks the workspace's own members: it adds and drops
#     entries to match the manifests but leaves registry deps on their pinned
#     versions, so this never smuggles a dependency bump into an unrelated
#     commit. (Plain `update` would bump everything; `metadata` is no good
#     either — it insists on downloading every package in the graph, including
#     ones this host never builds, so it fails even on a correct lock.)
#   --offline keeps it fast and network-free: re-locking only reads the registry
#     index, which is already on disk.
for manifest in Cargo.toml frontend/src-tauri/Cargo.toml; do
  lock="${manifest%Cargo.toml}Cargo.lock"
  cargo update --workspace --offline --manifest-path "$manifest" --quiet
  if ! git diff --quiet -- "$lock"; then
    git add "$lock"
    echo "   $lock was out of date — refreshed and added to this commit"
  fi
done

# svelte-check, eslint and the i18n check only look at frontend sources, so skip
# them all when nothing under frontend/ is staged (saves ~5s on backend commits).
staged_fe=$(git diff --cached --name-only --diff-filter=ACM -- 'frontend/')
if [ -n "$staged_fe" ]; then
  echo "== svelte-check =="
  # On Windows (Git Bash / MSYS), node isn't on the shell PATH by default.
  case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*) export PATH="/c/Program Files/nodejs:$PATH" ;;
  esac
  ( cd frontend && npm run check )

  echo "== eslint =="
  ( cd frontend && npm run lint )

  echo "== i18n locale keys =="
  node scripts/check-i18n-keys.mjs
else
  echo "== svelte-check / eslint / i18n: skipped (no staged frontend changes) =="
fi
