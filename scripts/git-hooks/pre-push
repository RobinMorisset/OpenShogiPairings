#!/bin/sh
# Slower gate that only needs to run before sharing work: the full test suite and
# the dependency-advisory check.
set -e

echo "== cargo test --workspace =="
cargo test --workspace

echo "== rustdoc (broken links) =="
# Rustdoc warnings never fail a build on their own, so a doc link that stopped
# resolving stays invisible until someone follows it — which is how two module
# docs came to point at names that no longer existed.
#   `-D warnings` is what makes it a gate. The `#![allow(...)]` in each crate root
#     still wins over it, so the deliberate links into private items stay quiet.
#   `--document-private-items` because much of the explanation here lives on
#     private items, and rustdoc only checks links in what it documents. Both of
#     those stale references were invisible without it.
# ~4s after a core edit, which is why this is here and not in pre-commit.
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --document-private-items --quiet

echo "== npm test (frontend) =="
(cd frontend && npm test)

echo "== dependency advisories (both lockfiles) =="
# Byte-for-byte the command CI runs, so an advisory can't first surface as a red
# build. Skipping when a tool is missing rather than failing: not having
# cargo-audit installed is not a reason to block someone's push, and CI is the
# backstop either way — but say so, loudly enough to be worth fixing.
# Probe the *subcommand*, not the binary: cargo finds subcommands in
# $CARGO_HOME/bin as well as on PATH, so `cargo audit` runs fine on a machine
# where `command -v cargo-audit` finds nothing — which is every push from a shell
# that never sourced ~/.cargo/env (a GUI or editor terminal, typically, when cargo
# itself comes from somewhere else like homebrew's rustup). Testing for the file
# skipped the check on exactly the setup that could run it. Costs ~0.04s.
if ! cargo audit --version >/dev/null 2>&1; then
  echo "   skipped: cargo-audit is not installed (cargo install cargo-audit)."
  echo "   CI still runs it, so a push without it can come back red."
elif command -v python3 >/dev/null 2>&1; then
  python3 scripts/check-advisories.py
elif command -v python >/dev/null 2>&1; then
  # Windows (Git Bash) often has `python` and no `python3`.
  python scripts/check-advisories.py
else
  echo "   skipped: no python interpreter found (the check is a python script)."
fi
