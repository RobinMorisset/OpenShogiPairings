#!/bin/sh
# Slower gate that only needs to run before sharing work: the full test suite and
# the dependency-advisory check.
set -e

echo "== cargo test --workspace =="
cargo test --workspace

echo "== ts-rs bindings up to date =="
# The tests above are what write frontend/src/lib/generated/, so this costs
# nothing but the diff — those files were rewritten a second ago by the run that
# just finished.
#   Here rather than in pre-commit deliberately. Regenerating at commit time
#   means building the test binaries: ~10s on a touched core file, almost all of
#   it compiling the ~4k lines of #[cfg(test)] code in osp-core and osp-server
#   that clippy only ever type-checks. By this point they are already built.
#   Nothing else catches the drift. Clippy does not regenerate; a Rust-only
#   commit stages no frontend file, so pre-commit's frontend block is skipped;
#   and CI type-checks a fresh checkout against the *committed* bindings, so a
#   stale copy stays green while the wire format and the TS types disagree.
#   `--others` as well as the diff: a newly exported type writes a file git has
#   never seen, which `git diff` alone would not report.
if ! git diff --quiet -- frontend/src/lib/generated ||
   [ -n "$(git ls-files --others --exclude-standard -- frontend/src/lib/generated)" ]; then
  echo
  echo "pre-push: the tests just regenerated frontend/src/lib/generated/ and it does"
  echo "  not match what you committed — a Rust type changed without its TypeScript"
  echo "  binding following. Commit the regenerated files, then push again:"
  echo "      git add frontend/src/lib/generated && git commit --amend --no-edit"
  echo "  (or as its own commit, when the change that caused it is further back)."
  exit 1
fi

echo "== rustdoc (broken links) =="
# Rustdoc warnings never fail a build on their own, so a doc link that stopped
# resolving stays invisible until someone follows it — which is how two module
# docs came to point at names that no longer existed.
#   `-D warnings` is what makes it a gate. The `#![allow(...)]` in each crate root
#     still wins over it, so the deliberate links into private items stay quiet.
#   `--document-private-items` because much of the explanation here lives on
#     private items, and rustdoc only checks links in what it documents. Both of
#     those stale references were invisible without it.
# ~4s after a core edit, which is why this is here and not in pre-commit.
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --document-private-items --quiet

# On Windows (Git Bash / MSYS), node isn't on the PATH a hook runs with: hooks
# don't source the interactive profile, so the entry a Node installer adds there
# isn't in scope. Same guard pre-commit carries, hoisted above both npm calls
# below rather than repeated in each.
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) export PATH="/c/Program Files/nodejs:$PATH" ;;
esac

echo "== npm test (frontend) =="
(cd frontend && npm test)

echo "== npm advisories =="
# The npm half of the advisory check. Byte-for-byte the command CI runs, for the
# same reason as the cargo one below: a push that passed here must not come back
# red an hour later.
#   `--audit-level=high`, not npm's default of moderate. The one moderate
#   outstanding is esbuild's dev-server advisory, reached only through
#   svelte-i18n's own nested copy, and npm's fix for it is a downgrade to
#   svelte-i18n 3.7.1 — a gate whose only remedy is worse than the finding is a
#   gate people learn to pass with --no-verify. It still gets printed.
# Needs the network (the tree goes to the registry to be scored), like the cargo
# check below.
(cd frontend && npm audit --audit-level=high)

echo "== dependency advisories (both lockfiles) =="
# Byte-for-byte the command CI runs, so an advisory can't first surface as a red
# build. Skipping when a tool is missing rather than failing: not having
# cargo-audit installed is not a reason to block someone's push, and CI is the
# backstop either way — but say so, loudly enough to be worth fixing.
# Probe the *subcommand*, not the binary: cargo finds subcommands in
# $CARGO_HOME/bin as well as on PATH, so `cargo audit` runs fine on a machine
# where `command -v cargo-audit` finds nothing — which is every push from a shell
# that never sourced ~/.cargo/env (a GUI or editor terminal, typically, when cargo
# itself comes from somewhere else like homebrew's rustup). Testing for the file
# skipped the check on exactly the setup that could run it. Costs ~0.04s.
if ! cargo audit --version >/dev/null 2>&1; then
  echo "   skipped: cargo-audit is not installed (cargo install cargo-audit)."
  echo "   CI still runs it, so a push without it can come back red."
else
  # Same lesson as the cargo probe above, which `command -v python3` had not
  # learned: ask the interpreter to *run*, not merely to exist on PATH. Windows
  # ships an App Execution Alias at
  # ~/AppData/Local/Microsoft/WindowsApps/python3 — a stub that is present, is
  # executable, and satisfies `command -v` — whose entire behaviour is to print
  # "Python was not found; run without arguments to install from the Microsoft
  # Store" and exit 49. On a machine with a real python installed as `python`,
  # the old probe therefore picked the stub, and `set -e` turned a working
  # advisory check into an aborted push. Running `-c ''` costs a few
  # milliseconds and tells the two apart: the stub fails it, a real interpreter
  # does not, and a name that isn't installed fails it too (127).
  python_bin=""
  for candidate in python3 python; do
    if "$candidate" -c "" >/dev/null 2>&1; then
      python_bin="$candidate"
      break
    fi
  done

  if [ -n "$python_bin" ]; then
    "$python_bin" scripts/check-advisories.py
  else
    echo "   skipped: no working python interpreter found (the check is a python"
    echo "   script). CI still runs it, so a push without it can come back red."
  fi
fi
